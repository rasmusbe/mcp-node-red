# Node-RED connection URL (required)
# NODE_RED_URL=http://localhost:1880

# Node-RED API token (optional, for standalone Node-RED)
# NODE_RED_TOKEN=your-api-token

# For Home Assistant add-on, embed credentials in URL:
# NODE_RED_URL=http://username:password@homeassistant.local:1880

# Transport: stdio (default) or streamable-http
# MCP_TRANSPORT=streamable-http
# MCP_HOST=127.0.0.1
# MCP_PORT=3000
# MCP_PATH=/mcp

# Host and Origin headers the HTTP transport accepts, comma separated.
# Hosts default to the address it is bound to, plus localhost when that is loopback.
# MCP_ALLOWED_HOSTS=mcp.internal:3000
# MCP_ALLOWED_ORIGINS=https://app.internal
